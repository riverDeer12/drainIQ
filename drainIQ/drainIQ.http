@drainIQ_HostAddress = http://localhost:5199

### Register a new user
# @name register
POST {{drainIQ_HostAddress}}/auth/register
Content-Type: application/json

{
  "email": "test@drainiq.hr",
  "password": "Test123!@#"
}

### Log in and capture the token for the requests below
# @name login
POST {{drainIQ_HostAddress}}/auth/login
Content-Type: application/json

{
  "email": "test@drainiq.hr",
  "password": "Test123!@#"
}

### Who am I (protected)
GET {{drainIQ_HostAddress}}/auth/me
Authorization: Bearer {{login.response.body.$.token}}

### List devices (protected)
GET {{drainIQ_HostAddress}}/devices
Authorization: Bearer {{login.response.body.$.token}}

### Create a device (protected)
# @name createDevice
POST {{drainIQ_HostAddress}}/devices
Authorization: Bearer {{login.response.body.$.token}}
Content-Type: application/json

{
  "deviceName": "Manhole - Korzo 1",
  "lat": 45.3271,
  "long": 14.4422,
  "description": "Test sensor"
}

### Update a device (protected)
PUT {{drainIQ_HostAddress}}/devices/1
Authorization: Bearer {{login.response.body.$.token}}
Content-Type: application/json

{
  "deviceName": "Manhole - Korzo 1 (renamed)",
  "lat": 45.3271,
  "long": 14.4422,
  "description": "Updated description"
}

### Send a measurement (device ingestion endpoint - no user auth, see code comment)
POST {{drainIQ_HostAddress}}/measurements
Content-Type: application/json

{
  "deviceId": 1,
  "waterLevelFromTopCm": 42.5
}

### Get measurements for a device (protected)
GET {{drainIQ_HostAddress}}/devices/1/measurements
Authorization: Bearer {{login.response.body.$.token}}

### Create an alarm rule (protected)
POST {{drainIQ_HostAddress}}/alarm-rules
Authorization: Bearer {{login.response.body.$.token}}
Content-Type: application/json

{
  "deviceId": 1,
  "alarmName": "High water level",
  "alarmType": "water_level",
  "thresholdValue": 10.0,
  "comparator": "<="
}

### List alarms (protected)
GET {{drainIQ_HostAddress}}/alarms
Authorization: Bearer {{login.response.body.$.token}}

###
